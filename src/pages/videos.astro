---
import yaml from 'js-yaml';
import videosRaw from '../data/videos.yaml?raw';
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const videos = yaml.load(videosRaw) || [];
const groups = [...new Set(videos.map((v) => v.group))];
---
<Base title="Derivation videos" description="Animated Manim walk-throughs of the load-bearing derivations.">
  <section>
    <div class="wrap">
      <h2>Derivation <span class="acc">videos</span></h2>
      <p class="lead">
        {videos.length} Manim animations stepping through the load-bearing derivations of the dual
        framework. Shown at 480p; full-resolution renders are reproducible from the
        <a href="https://github.com/Proper-Time-Physics-Institute/animations">animations</a> repo.
      </p>
      {groups.map((g) => (
        <div>
          <h3 style="margin-top:2rem">{g}</h3>
          <div class="grid">
            {videos.filter((v) => v.group === g).map((v) => (
              <div class="vid">
                <video controls preload="metadata" src={`${base}${v.src}`}></video>
                <div class="cap"><h3>{v.title}</h3></div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>
